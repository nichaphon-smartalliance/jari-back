# ─── Server ───────────────────────────────────────────────────────────────
PORT=4000

# Secret used to sign login tokens (HMAC). Change in production.
AUTH_SECRET=change-me-to-a-long-random-string

# ─── Database (PostgreSQL) ──────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:smart2026@localhost:5432/jari_db

# ─── AI Center (Develyst AI) — see ../docs/03-ai-center.md ──────────────────
AI_API_BASE_URL=http://localhost:3009

# ─── Jira workspaces (up to 20: JIRA_WORKSPACE_2_*, ...) ────────────────────
# Tokens are SECRET. Never commit a real .env.
JIRA_WORKSPACE_1_URL=https://smart-alliance-dev.atlassian.net
JIRA_WORKSPACE_1_EMAIL=you@smartalliance.co.th
JIRA_WORKSPACE_1_TOKEN=__atlassian_api_token__
JIRA_WORKSPACE_1_NAME=Smart Alliance Dev
